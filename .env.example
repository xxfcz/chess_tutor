# Debug Mode
# Set to 'true' to enable debug mode which shows LLM prompts and responses
# This is useful for debugging AI behavior
NEXT_PUBLIC_DEBUG=false

# Gemini model used by the AI tutor / analysis features.
# Defaults to gemini-3.8-flash. Override here if Google retires or renames it
# (e.g. NEXT_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite for the cheapest tier).
# NEXT_PUBLIC_GEMINI_MODEL=gemini-3.8-flash

