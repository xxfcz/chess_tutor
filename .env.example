# Debug Mode
# Set to 'true' to enable debug mode which shows LLM prompts and responses
# This is useful for debugging AI behavior
NEXT_PUBLIC_DEBUG=false

# ---------------------------------------------------------------------------
# LLM provider configuration (OpenAI-compatible Chat Completions)
#
# The app talks to any OpenAI-compatible endpoint (OpenAI, OpenRouter,
# Together, a local LLM via Ollama/LM Studio/vLLM, or a Gemini-to-OpenAI
# proxy). Configure the base URL, API key and model here (server + client),
# or in the in-app Settings page (stored in the browser's local storage).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_LLM_BASE_URL=https://api.openai.com/v1
# NEXT_PUBLIC_LLM_API_KEY=sk-...
# NEXT_PUBLIC_LLM_MODEL=gpt-4o-mini

# Legacy Gemini fallback (still supported if you only set these):
# NEXT_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
# NEXT_PUBLIC_GEMINI_API_KEY=...

